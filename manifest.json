{
  "manifest_version": 3,
  "name": "ThreatKey",
  "version": "3.0.0",
  "description": "キーボードでテキスト選択＆脅威インテリジェンス即時参照（NVD / CISA KEV / EPSS / MITRE ATT&CK / RansomLook / Malpedia / VirusTotal）",
  "minimum_chrome_version": "105",
  "permissions": [
    "tabs",
    "clipboardWrite",
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://services.nvd.nist.gov/*",
    "https://api.first.org/*",
    "https://www.cisa.gov/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "選択タブのURLをコピー"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_page": "options.html",
  "commands": {
    "activate": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "KeySelect を起動"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["attack-data.json"],
      "matches": ["http://*/*", "https://*/*", "file:///*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["tk-utils.js", "tk-highlighter.js", "content.js", "cve-highlight.js", "attack-highlight.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
